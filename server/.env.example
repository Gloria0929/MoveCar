# 服务端口
PORT=3000

# 二维码里写入的站点地址，上线必须改成 HTTPS 域名
PUBLIC_BASE_URL=http://localhost:3000

# JWT 与敏感字段加密的根密钥，生产环境请替换为 32 字节随机值
SECRET_KEY=dev-local-secret-key-please-change-in-production

# 开发环境固定验证码（本项目已无登录，可留空）
DEV_FIXED_CODE=

# 短信通道：mock（打印到控制台）| aliyun（真实发送，需签名与模板审核通过）
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_REGION=cn-hangzhou


# 高德 Web 服务 Key（可选）：配置后访客定位能自动反查地址，不配则只记录坐标
AMAP_KEY=

# 可选 HTTPS：证书存在 server/certs/lan-key.pem + lan-cert.pem 时自动启用
# 手机浏览器只在 https 下允许定位（http 内网地址会被直接拒绝）
HTTPS_PORT=3443

NODE_ENV=development

# 演示车贴（可选）：允许用 DEMO_OWNER_TOKEN 直接管理，且禁止重置恢复链接
DEMO_CODES=PARK2DAY
DEMO_OWNER_TOKEN=demo-owner-token-please-keep-secret
